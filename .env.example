# MeetingMinutes configuration. Copy to .env (scripts/install.sh does this for you).
# Everything is optional; the defaults run the site on 127.0.0.1:8787.

# ---------------------------------------------------------------- web server
# Bind address and port. For a public IP either:
#   - serve HTTPS directly: HOST=0.0.0.0, PORT=8443 and the TLS_* files below, or
#   - keep 127.0.0.1 and put Caddy/nginx in front (see README).
HOST=127.0.0.1
PORT=8787
# Built-in HTTPS (no reverse proxy). scripts/make-cert.sh <public-ip> creates these.
# TLS_CERT_FILE=data/tls/server.crt
# TLS_KEY_FILE=data/tls/server.key
# With built-in HTTPS, local GPU workers use this loopback-only HTTP port.
# INTERNAL_PORT=8788
# The URL people use to reach the site. Enables Secure cookies + HSTS when https,
# and is used for invite links.
PUBLIC_URL=
# How people reach the administrator when they have no account or forgot their
# password; shown on the sign-in page. An email address becomes a mailto link.
# e.g. ADMIN_CONTACT=it-help@example.com   or   ADMIN_CONTACT=Slack #it-help
ADMIN_CONTACT=
# Export summaries straight into Google Docs: the client ID of a Google OAuth
# client of type "Web application", with PUBLIC_URL as an authorised JavaScript
# origin and the Google Drive API enabled (see README, "Exporting to Google
# Docs"). No client secret is needed. Empty: summaries are copied with their
# formatting, to paste into a new Google Doc.
GOOGLE_CLIENT_ID=
# Set to true when behind a reverse proxy so client IPs (rate limiting) come from X-Forwarded-For.
TRUST_PROXY=false
# Where the SQLite database and media files live.
DATA_DIR=data
SESSION_TTL_DAYS=30
# Largest file accepted (4096 = 4 GB). Files are sent in chunks, so this is not
# limited by memory.
MAX_UPLOAD_MB=4096
# Upload chunk size. Behind a proxy, keep it below the proxy's body limit (Cloudflare: 100 MB).
UPLOAD_CHUNK_MB=32
# Longest recording a worker decodes, in hours. A small file that expands into
# more audio than this (a crafted or corrupt file) is rejected instead of
# exhausting the worker's memory.
MAX_AUDIO_HOURS=8

# Speaker recognition by voice (see README, "Recognising speakers by voice").
# Cosine similarity of voice fingerprints, from -1 to 1: at or above MATCH a
# speaker is named after a known voice; from SUGGEST up to MATCH the name is
# only suggested. Raise them if people are confused with one another; lower
# MATCH if the same person is often only suggested.
VOICE_MATCH_THRESHOLD=0.6
VOICE_SUGGEST_THRESHOLD=0.45
# Seconds of speech a speaker needs before their voice is remembered or compared.
VOICE_MIN_SPEECH_SEC=5

# Shared secret between the backend and GPU workers. Generated on first start
# into data/worker.token when left empty.
WORKER_TOKEN=

# ----------------------------------------------------------- summary model
# Who writes summaries: local (a model on your own GPU) or codex (ChatGPT plan).
# These are defaults: administrators can change all of them in Admin → Summary
# model, and what they save there wins until they reset it.
SUMMARY_PROVIDER=local
# The local model server: Ollama (scripts/llm.sh serve), or an OpenAI-compatible
# one (vLLM, llama.cpp, LM Studio, SGLang) with LLM_API=openai.
LLM_API=ollama
# Ollama listens on this machine only (scripts/llm.sh refuses any other address):
# it has no authentication, and only the web server talks to it.
LLM_BASE_URL=http://127.0.0.1:11434
# Qwen3.8 27B, 3-bit (Q3_K_M, about 13 GB). Download: scripts/llm.sh pull
LLM_MODEL=batiai/qwen3.8-27b:q3
# Prompt + answer, in tokens. Longer transcripts are read in parts, never cut off.
LLM_CONTEXT_TOKENS=65536
# Let the model think before writing (slower; sometimes better on hard meetings).
LLM_THINK=false
# Seconds the model stays in GPU memory after a summary (0 = free it for transcription at once).
LLM_KEEP_ALIVE_SEC=0
# Longest a summary may take, and how many run at once.
LLM_TIMEOUT_SEC=3600
LLM_CONCURRENCY=1
# GPUs Ollama may use (nvidia-smi numbers, e.g. 1). Empty = all.
LLM_GPUS=
# Where scripts/llm.sh keeps Ollama (a few GB) and its models (about 13 GB for
# the default). Move them off a home directory with a quota, e.g.
#   OLLAMA_PREFIX=~/tmp/ollama
#   OLLAMA_MODELS=~/tmp/.ollama/models
# Empty: ~/.local/ollama and ~/.ollama/models.
OLLAMA_PREFIX=
OLLAMA_MODELS=
# Bearer token, only for an OpenAI-compatible server started with an API key.
LLM_API_KEY=

# --------------------------------------------------------------------- codex
# With SUMMARY_PROVIDER=codex, summaries run `codex exec` with the ChatGPT login of the server account
# (run `bun run codex:login` once). Leave CODEX_BIN empty to use the bundled CLI.
CODEX_BIN=
# CODEX_HOME=/home/you/.codex
# Model and reasoning effort; empty uses Codex's defaults.
CODEX_MODEL=
CODEX_REASONING_EFFORT=
# Parallel summaries. Each one uses your plan's quota.
CODEX_CONCURRENCY=1
CODEX_TIMEOUT_SEC=1200

# -------------------------------------------------------------------- worker
# Hugging Face token (read access) for pyannote speaker diarization. Accept the
# conditions of pyannote/speaker-diarization-community-1 with the same account.
HF_TOKEN=
ASR_MODEL=Qwen/Qwen3-ASR-1.7B
# transformers (default) or vllm (faster, needs `scripts/install.sh --vllm`).
ASR_BACKEND=transformers
ASR_BATCH_SIZE=16
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
MAX_SEGMENT_SEC=30
# Models are loaded onto the GPU only while there is work, then the GPU process
# exits and all VRAM is released. Seconds to wait for another job before exiting:
MODEL_KEEPALIVE_SEC=0
# GPUs to run workers on (comma separated). Empty = every GPU nvidia-smi reports.
WORKER_GPUS=
# Backend URL as seen from the worker. Default: http://127.0.0.1:PORT, or
# http://127.0.0.1:INTERNAL_PORT when TLS_CERT_FILE is set.
# MM_SERVER_URL=http://127.0.0.1:8787
