# MeetingMinutes configuration. Copy to .env (scripts/install.sh does this for you).
# Everything is optional; the defaults run the site on 127.0.0.1:8787.

# ---------------------------------------------------------------- web server
# Bind address and port. For a public IP either:
#   - serve HTTPS directly: HOST=0.0.0.0, PORT=8443 and the TLS_* files below, or
#   - keep 127.0.0.1 and put Caddy/nginx in front (see README).
HOST=127.0.0.1
PORT=8787
# Built-in HTTPS (no reverse proxy). scripts/make-cert.sh <public-ip> creates these.
# TLS_CERT_FILE=data/tls/server.crt
# TLS_KEY_FILE=data/tls/server.key
# With built-in HTTPS, local GPU workers use this loopback-only HTTP port.
# INTERNAL_PORT=8788
# The URL people use to reach the site. Enables Secure cookies + HSTS when https,
# and is used for invite links.
PUBLIC_URL=
# How people reach the administrator when they have no account or forgot their
# password; shown on the sign-in page. An email address becomes a mailto link.
# e.g. ADMIN_CONTACT=it-help@example.com   or   ADMIN_CONTACT=Slack #it-help
ADMIN_CONTACT=
# Set to true when behind a reverse proxy so client IPs (rate limiting) come from X-Forwarded-For.
TRUST_PROXY=false
# Where the SQLite database and media files live.
DATA_DIR=data
SESSION_TTL_DAYS=30
# Largest file accepted (4096 = 4 GB). Files are sent in chunks, so this is not
# limited by memory.
MAX_UPLOAD_MB=4096
# Upload chunk size. Behind a proxy, keep it below the proxy's body limit (Cloudflare: 100 MB).
UPLOAD_CHUNK_MB=32

# Shared secret between the backend and GPU workers. Generated on first start
# into data/worker.token when left empty.
WORKER_TOKEN=

# --------------------------------------------------------------------- codex
# Summaries run `codex exec` with the ChatGPT login of the server account
# (run `bun run codex:login` once). Leave CODEX_BIN empty to use the bundled CLI.
CODEX_BIN=
# CODEX_HOME=/home/you/.codex
# Model and reasoning effort; empty uses Codex's defaults.
CODEX_MODEL=
CODEX_REASONING_EFFORT=
# Parallel summaries. Each one uses your plan's quota.
CODEX_CONCURRENCY=1
CODEX_TIMEOUT_SEC=1200

# -------------------------------------------------------------------- worker
# Hugging Face token (read access) for pyannote speaker diarization. Accept the
# conditions of pyannote/speaker-diarization-community-1 with the same account.
HF_TOKEN=
ASR_MODEL=Qwen/Qwen3-ASR-1.7B
# transformers (default) or vllm (faster, needs `scripts/install.sh --vllm`).
ASR_BACKEND=transformers
ASR_BATCH_SIZE=16
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
MAX_SEGMENT_SEC=30
# Models are loaded onto the GPU only while there is work, then the GPU process
# exits and all VRAM is released. Seconds to wait for another job before exiting:
MODEL_KEEPALIVE_SEC=0
# GPUs to run workers on (comma separated). Empty = every GPU nvidia-smi reports.
WORKER_GPUS=
# Backend URL as seen from the worker. Default: http://127.0.0.1:PORT, or
# http://127.0.0.1:INTERNAL_PORT when TLS_CERT_FILE is set.
# MM_SERVER_URL=http://127.0.0.1:8787
